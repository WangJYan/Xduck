#!/usr/bin/python3
"""Reserve CPU3 for robot.slice; restore the previous sibling masks on stop.

Only PID1 changes cgroups, through systemctl. No robot socket or hardware access.
"""
import json
import os
import signal
from pathlib import Path
import subprocess
import sys


SLICES = ('system.slice', 'user.slice', 'machine.slice')
STATE = Path('/run/robot-policy-isolation/previous.json')


def property_value(unit, name):
    return subprocess.check_output(['systemctl', 'show', unit, '-p', name, '--value'],
                                   text=True).strip()


def set_mask(unit, mask):
    subprocess.run(['systemctl', 'set-property', '--runtime', unit, 'AllowedCPUs='+mask], check=True)


def cpus(mask):
    result = set()
    for part in mask.replace(',', ' ').split():
        bounds = [int(value) for value in part.split('-')]
        result.update(range(bounds[0], bounds[-1]+1))
    return result


def restore():
    if not STATE.exists():
        return
    previous = json.loads(STATE.read_text())
    errors = []
    for unit, mask in previous.items():
        try:
            set_mask(unit, mask)
        except subprocess.CalledProcessError as error:
            errors.append(str(error))
    if errors:
        raise RuntimeError('; '.join(errors))
    STATE.unlink()


def start():
    if not {0, 1, 2, 3}.issubset(cpus(property_value('robot.slice', 'EffectiveCPUs'))):
        raise RuntimeError('robot.slice must have CPUs 0-3 available')
    if STATE.exists():
        raise RuntimeError('previous CPU reservation still exists; stop before starting again')
    # Snapshot before any mutation, including a failed/partially applied setup.
    previous = {unit: property_value(unit, 'AllowedCPUs') for unit in SLICES}
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with STATE.open('x') as output:
        json.dump(previous, output)
        output.flush()
        os.fsync(output.fileno())
    try:
        for unit, original in previous.items():
            allowed = cpus(original) if original else {0, 1, 2, 3}
            allowed &= {0, 1, 2}
            if not allowed:
                raise RuntimeError(f'{unit} has no housekeeping CPU available')
            set_mask(unit, ','.join(map(str, sorted(allowed))))
            effective = cpus(property_value(unit, 'EffectiveCPUs'))
            configured = cpus(property_value(unit, 'AllowedCPUs'))
            # An inactive machine.slice has no cgroup yet. Verify its configured
            # mask now; future scopes inherit it when the slice is activated.
            inactive = property_value(unit, 'ActiveState') == 'inactive'
            if configured != allowed or 3 in effective or (not effective and not inactive):
                raise RuntimeError(f'{unit} failed to exclude CPU3: {effective}')
    except BaseException:
        restore()
        raise
    print('Reserved CPU3: system/user/machine slices exclude it; robot.slice retains CPUs 0-3', flush=True)


if __name__ == '__main__':
    def interrupted(signum, _frame):
        raise SystemExit(128+signum)
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, interrupted)
    if sys.argv[1:] == ['start']:
        start()
    elif sys.argv[1:] == ['stop']:
        restore()
    else:
        raise SystemExit('usage: robot-policy-cpu-isolation start|stop')
