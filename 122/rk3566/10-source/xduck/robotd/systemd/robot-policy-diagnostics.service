[Unit]
Description=Policy deadline CPU flight recorder
Requires=sys-kernel-tracing.mount
After=local-fs.target systemd-journald.service sys-kernel-tracing.mount
Before=robotd.service
PartOf=robotd.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /usr/local/sbin/robot-policy-diagnostics
TimeoutStartSec=10
TimeoutStopSec=5
Restart=on-failure
RestartSec=1
User=root
AllowedCPUs=0-2
Nice=10
CPUWeight=10
StateDirectory=robot-policy-diagnostics
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/sys/kernel/tracing
RestrictSUIDSGID=yes
StandardOutput=journal
StandardError=journal
