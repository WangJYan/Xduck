[Unit]
Description=Reserve policy CPU against desktop and system services
Requires=robot.slice
After=robot.slice
Before=robotd.service
PartOf=robotd.service

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=robot.slice
CPUAffinity=0-2
ExecStart=/usr/local/sbin/robot-policy-cpu-isolation start
ExecStop=/usr/local/sbin/robot-policy-cpu-isolation stop
ExecStopPost=/usr/local/sbin/robot-policy-cpu-isolation stop
RuntimeDirectory=robot-policy-isolation
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=10s
TimeoutStopSec=10s
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
